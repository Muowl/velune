{
  "name": "velune",
  "displayName": "Velune",
  "description": "A dark theme inspired by Evernight, with soft plum surfaces, pastel syntax and quiet controls.",
  "version": "0.2.0",
  "publisher": "muowl",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "dark",
    "theme",
    "lavender",
    "evernight",
    "velune",
    "rust",
    "java",
    "csharp",
    "cpp",
    "cursor"
  ],
  "galleryBanner": {
    "color": "#211E28",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "themes": [
      {
        "label": "Velune Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/velune-dark-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-icon.mjs",
    "test": "node scripts/validate.mjs",
    "vscode:prepublish": "npm run build && npm test",
    "package": "vsce package --no-dependencies --out dist/velune-0.2.0.vsix",
    "build:icon": "node scripts/build-icon.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "sharp": "0.35.5",
    "shiki": "4.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Muowl/velune.git"
  },
  "homepage": "https://github.com/Muowl/velune#readme",
  "bugs": {
    "url": "https://github.com/Muowl/velune/issues"
  },
  "icon": "assets/icon.png"
}
