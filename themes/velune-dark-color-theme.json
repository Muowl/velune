  "tokenColors": [
    {
      "name": "Default text and identifiers",
      "scope": [
        "variable",
        "meta.definition.variable",
        "support.variable",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#D3CDDD",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A196AC",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation and operators",
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#B2A6C1",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.logical.python",
        "keyword.operator.membership.python"
      ],
      "settings": {
        "foreground": "#BBA0DF",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and callable names",
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.function.decorator",
        "support.function.builtin.python"
      ],
      "settings": {
        "foreground": "#A9B9DE",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "support.type.primitive",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#CFABC6",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ABBFA3",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers, constants, booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#D5BA93",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and interpolation delimiters",
      "scope": [
        "constant.character.escape",
        "punctuation.section.interpolation",
        "punctuation.definition.template-expression",
        "punctuation.definition.interpolation"
      ],
      "settings": {
        "foreground": "#94BDB9",
        "fontStyle": ""
      }
    },
    {
      "name": "Template expression body",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#D3CDDD",
        "fontStyle": ""
      }
    },
    {
      "name": "Embedded code",
      "scope": [
        "source.js.embedded",
        "source.ts.embedded",
        "source.css.embedded"
      ],
      "settings": {
        "foreground": "#D3CDDD",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#ABBFA3",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expression operators",
      "scope": [
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp",
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#BBA0DF",
        "fontStyle": ""
      }
    },
    {
      "name": "HTML and JSX tags",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "entity.name.tag.tsx",
        "entity.name.tag.jsx"
      ],
      "settings": {
        "foreground": "#BBA0DF",
        "fontStyle": ""
      }
    },
    {
      "name": "HTML and JSX attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx"
      ],
      "settings": {
        "foreground": "#CFABC6",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#CFABC6",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": {
        "foreground": "#D3CDDD",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS values and units",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color.w3c-standard-color-name.css",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#D5BA93",
        "fontStyle": ""
      }
    },
    {
      "name": "JSON property names",
      "scope": [
        "support.type.property-name.json",
        "string.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#CFABC6",
        "fontStyle": ""
      }
    },
    {
      "name": "JSON property punctuation",
      "scope": [
        "punctuation.support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#B2A6C1",
        "fontStyle": ""
      }
    },
    {
      "name": "C++ reference and pointer declarators",
      "scope": [
        "storage.modifier.reference.cpp",
        "storage.modifier.pointer.cpp"
      ],
      "settings": {
        "foreground": "#B2A6C1",
        "fontStyle": ""
      }
    },
    {
      "name": "C++ lambda return types",
      "scope": [
        "storage.type.return-type.lambda.cpp"
      ],
      "settings": {
        "foreground": "#CFABC6",
        "fontStyle": ""
      }
    },
    {
      "name": "C++ attributes",
      "scope": [
