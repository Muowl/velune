  "tokenColors": [
    {
      "name": "Default text and identifiers",
      "scope": [
        "variable",
        "meta.definition.variable",
        "support.variable",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#E6DFEC",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#96889F",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation and operators",
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#B4A7C2",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.logical.python",
        "keyword.operator.membership.python"
      ],
      "settings": {
        "foreground": "#C99AF7",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions and callable names",
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.function.decorator",
        "support.function.builtin.python"
      ],
      "settings": {
        "foreground": "#AFBEF1",
        "fontStyle": ""
      }
    },
    {
      "name": "Types and namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.built-in",
        "support.type.primitive",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#E2B1D6",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#B5CBAA",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers, constants, booleans",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#E2C291",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and interpolation delimiters",
      "scope": [
        "constant.character.escape",
        "punctuation.section.interpolation",
        "punctuation.definition.template-expression",
        "punctuation.definition.interpolation"
      ],
      "settings": {
        "foreground": "#95CCC8",
        "fontStyle": ""
      }
    },
    {
      "name": "Template expression body",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#E6DFEC",
        "fontStyle": ""
      }
    },
    {
      "name": "Embedded code",
      "scope": [
        "source.js.embedded",
        "source.ts.embedded",
        "source.css.embedded"
      ],
      "settings": {
        "foreground": "#E6DFEC",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#B5CBAA",
        "fontStyle": ""
      }
    },
    {
      "name": "Regular expression operators",
      "scope": [
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp",
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#C99AF7",
        "fontStyle": ""
      }
    },
    {
      "name": "HTML and JSX tags",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "entity.name.tag.tsx",
        "entity.name.tag.jsx"
      ],
      "settings": {
        "foreground": "#C99AF7",
        "fontStyle": ""
      }
    },
    {
      "name": "HTML and JSX attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx"
      ],
      "settings": {
        "foreground": "#E2B1D6",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#E2B1D6",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": {
        "foreground": "#E6DFEC",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS values and units",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.color.w3c-standard-color-name.css",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#E2C291",
        "fontStyle": ""
      }
    },
    {
      "name": "JSON property names",
      "scope": [
        "support.type.property-name.json",
        "string.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#E2B1D6",
        "fontStyle": ""
      }
    },
    {
      "name": "JSON property punctuation",
      "scope": [
        "punctuation.support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#B4A7C2",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#C99AF7",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#B5CBAA",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
